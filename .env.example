# Copy to `.env` and change every value before deploying anywhere public.

POSTGRES_USER=bajrang
POSTGRES_PASSWORD=bajrang
POSTGRES_DB=bajrang

# For `npm run dev` on the host (Postgres from `docker compose up -d db`).
DATABASE_URL=postgres://bajrang:bajrang@localhost:5432/bajrang

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# Defaults to http://localhost:$APP_PORT; set it to your public URL in production.
# BETTER_AUTH_URL=https://bajrangbadminton.in

# First admin account, created by `npm run db:seed` if it doesn't exist.
ADMIN_EMAIL=admin@bajrang.academy
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Academy Admin

# Host ports (change if 3000/5432 are taken by other projects)
APP_PORT=3000
DB_PORT=5432
