# Production settings for the Oracle VM. Copy to `.env` next to
# docker-compose.prod.yml and fill in every value. Never commit the real file.

# Public address (Cloudflare Tunnel hostname)
PUBLIC_URL=https://app.sksap.com

# Database — generate the password with: openssl rand -hex 24
POSTGRES_USER=bajrang
POSTGRES_DB=bajrang
POSTGRES_PASSWORD=

# Sessions — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# First admin account, created on the first deploy. Use a strong password:
# it unlocks the whole admin panel.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Academy Admin

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → token
CLOUDFLARE_TUNNEL_TOKEN=

# Backups: keep this many days of dumps on the VM
BACKUP_KEEP_DAYS=14
# Optional: Oracle Object Storage pre-authenticated request (PAR) URL ending in /o/
# (bucket-level, "Permit object writes"). Leave empty to keep backups on the VM only.
BACKUP_UPLOAD_URL=
